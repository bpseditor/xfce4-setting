#!/usr/bin/python3
"""Maintain 40/80 hysteresis, with one top-up on each adapter connection.
No forced discharge. Fixed sysfs paths; no external commands or user input.
"""
import json, os, select, signal, socket, time
from pathlib import Path
BAT=Path('/sys/class/power_supply/BAT0')
STATE=Path('/run/charge-guard.json')

def decide(previous_ac, topping, ac, percent, resumed=False):
    if not ac:
        return False, 79  # Arm the next connection, including while asleep.
    if previous_ac is not True or resumed:
        topping = percent < 80
    if percent >= 80:
        topping = False
    return topping, 79 if topping else 40

def value(name):
    return (BAT/name).read_text().strip()

def set_threshold(start):
    # Lower the start first if the pre-existing range is above our stop.
    p=BAT/'charge_control_start_threshold'
    q=BAT/'charge_control_end_threshold'
    if int(p.read_text()) > 80: p.write_text('40')
    if int(q.read_text()) != 80: q.write_text('80')
    if int(p.read_text()) != start: p.write_text(str(start))

def main():
    os.umask(0o022)
    sock=socket.socket(socket.AF_NETLINK,socket.SOCK_DGRAM,15)
    sock.bind((os.getpid(),1))
    previous_ac=None
    topping=False
    last_sleep=time.clock_gettime(time.CLOCK_BOOTTIME)-time.monotonic()
    last_state=None
    stopping=False
    def stop(*args):
        nonlocal stopping
        stopping=True
    signal.signal(signal.SIGTERM,stop)
    signal.signal(signal.SIGINT,stop)
    while not stopping:
        try:
            ac=(Path('/sys/class/power_supply/AC/online').read_text().strip()=='1')
            percent=int(value('capacity'))
            sleep=time.clock_gettime(time.CLOCK_BOOTTIME)-time.monotonic()
            topping,start=decide(previous_ac,topping,ac,percent,sleep-last_sleep>2)
            last_sleep=sleep
            set_threshold(start)
            previous_ac=ac
            state={'ac':ac,'top_up':topping,'start':start,'stop':80,'forced_discharge':False}
            if state != last_state:
                temp=STATE.with_suffix('.tmp')
                temp.write_text(json.dumps(state)+'\n');temp.replace(STATE)
                print(time.strftime('%F %T'),json.dumps(state),flush=True)
                last_state=state
        except (OSError,ValueError) as exc:
            print(time.strftime('%F %T'),'ERROR',str(exc),flush=True)
        # Netlink catches even brief unplug/replug events; periodic reconciliation
        # handles resume and threshold restoration by TLP.
        ready,_,_=select.select([sock],[],[],10)
        if ready:
            message,address=sock.recvfrom(65536)
            if address[0] == 0:
                fields=dict(s.split('=',1) for s in message.decode(errors='replace').split('\0') if '=' in s)
                if fields.get('SUBSYSTEM')=='power_supply' and fields.get('POWER_SUPPLY_NAME')=='AC':
                    if fields.get('POWER_SUPPLY_ONLINE')=='0': previous_ac=False
            # Ignore unrelated events without adding a fixed delay.
    # Leave ordinary persistent 40/80 thresholds on a clean stop.
    set_threshold(40)
    STATE.unlink(missing_ok=True)

if __name__=='__main__': main()
