#!/usr/bin/python3
"""Send an eye-break reminder from the logged-in XFCE session."""
import fcntl
import logging
from logging.handlers import RotatingFileHandler
import os
from pathlib import Path
import subprocess
import sys
import time

os.umask(0o077)
state = Path.home() / ".local/state/eye-break-reminder"
state.mkdir(mode=0o700, parents=True, exist_ok=True)
handler = RotatingFileHandler(state / "reminder.log", maxBytes=65536, backupCount=1)
handler.setFormatter(logging.Formatter("%(asctime)s %(levelname)s %(message)s"))
logger = logging.getLogger("eye-break-reminder")
logger.addHandler(handler)
logger.setLevel(logging.INFO)

def notify(title, body):
    subprocess.run(
        ["/usr/bin/notify-send", "--app-name=Eye break reminder",
         "--urgency=normal", "--expire-time=15000", title, body],
        check=True, timeout=10,
    )

if not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
    logger.error("No session bus; launch this program from XFCE autostart.")
    sys.exit(1)

if sys.argv[1:] == ["--test-notification"]:
    notify("Eye break reminder configured", "After XFCE login: a break every 20 minutes.")
    sys.exit(0)
if sys.argv[1:]:
    sys.exit("Unsupported arguments")

runtime = Path(os.environ.get("XDG_RUNTIME_DIR", ""))
if not runtime.is_absolute() or not runtime.is_dir() or runtime.stat().st_uid != os.getuid():
    logger.error("No private runtime directory.")
    sys.exit(1)
with (runtime / "eye-break-reminder.lock").open("a") as lock:
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit(0)
    result = subprocess.run(
        ["/usr/bin/pgrep", "-u", str(os.getuid()), "-x", "xfce4-session"],
        capture_output=True, text=True, check=False,
    )
    pids = result.stdout.split()
    if not pids:
        logger.error("No active XFCE session.")
        sys.exit(1)
    session = Path("/proc") / pids[0]
    def session_identity():
        try:
            if session.stat().st_uid != os.getuid():
                return None
            # Field 22 (starttime), after the parenthesised comm field.
            return (session / "stat").read_text().rpartition(")")[2].split()[19]
        except (OSError, IndexError):
            return None
    identity = session_identity()
    if identity is None:
        sys.exit(1)
    logger.info("Started in XFCE session %s; interval 1200 seconds.", pids[0])
    deadline = time.monotonic() + 1200
    while session_identity() == identity:
        remaining = deadline - time.monotonic()
        if remaining > 0:
            time.sleep(min(5, remaining))
            continue
        try:
            notify("Time for an eye break", "Look into the distance for at least 20 seconds.")
            logger.info("Reminder delivered.")
        except (subprocess.SubprocessError, OSError):
            logger.exception("Could not deliver reminder.")
        deadline = time.monotonic() + 1200
    logger.info("XFCE session ended; exiting.")

