  "xfce4-terminal": {
    "/font-name": "JetBrains Mono 11",
    "/font-use-system": false,
    "/color-use-theme": false,
    "/color-foreground": "#bfbdb6",
    "/color-background": "#151920",
    "/color-cursor": "#bfbdb6",
    "/color-palette": "#46515e;#df8585;#a8bb85;#d9ad72;#73a9c2;#c6a77b;#d9ad72;#a6a9ab;#6b747e;#df8585;#a8bb85;#d9ad72;#73a9c2;#c6a77b;#d9ad72;#bfbdb6",
    "/misc-menubar-default": false
  },
  "xfce4-notifyd": {
    "/theme": "AyuComfort"
  },
  "xfce4-power-manager": {
    "/xfce4-power-manager/brightness-on-battery": 60,
    "/xfce4-power-manager/brightness-level-on-battery": 30,
    "/xfce4-power-manager/blank-on-battery": 3,
    "/xfce4-power-manager/dpms-enabled": true,
    "/xfce4-power-manager/dpms-on-battery-sleep": 4,
    "/xfce4-power-manager/dpms-on-battery-off": 5,
    "/xfce4-power-manager/lock-screen-suspend-hibernate": true
  },
  "xfce4-screensaver": {
    "/saver/mode": 0,
    "/saver/idle-activation/delay": 15,
    "/saver/idle-activation/enabled": true,
    "/lock/enabled": true,
    "/lock/saver-activation/enabled": true,
    "/lock/saver-activation/delay": 0,
    "/saver/enabled": true
  },
  "xfce4-desktop": {
    "/desktop-icons/icon-size": 40,
    "/desktop-icons/font-size": 10.0,
    "/desktop-icons/use-custom-font-size": true
  }
