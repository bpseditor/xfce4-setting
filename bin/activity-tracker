    hint=Gtk.Label(label='During a timer, the panel shows app time in that session.\nHover for full names, daily totals and all running timers.',xalign=0);hint.set_line_wrap(True);prefs.pack_start(hint,False,False,0)
    feedback=Gtk.Label(xalign=0);feedback.set_line_wrap(True)
    apply=Gtk.Button(label='Apply preferences');apply.set_sensitive(False)
    dirty=[False]
    def changed(*_):
        dirty[0]=True;apply.set_sensitive(True);feedback.set_text('Unsaved changes — press Apply to save.')
    def apply_display(*_):
        current=settings()
        current.update({'show_'+r[0]:r[2] for r in model})
        current.update(panel_order=','.join(r[0] for r in model),compact=compact.get_active(),panel_font=font.get_font(),name_length=length.get_value_as_int(),idle_mode=idle_mode.get_active_id(),idle_seconds=idle_limit.get_value_as_int())
        try: save_settings(current)
        except OSError as exc: feedback.set_text('Could not save: '+str(exc));return
        dirty[0]=False;apply.set_sensitive(False);feedback.set_text('Saved. Panel updates within one second.')
    for signal in ('row-changed','rows-reordered','row-inserted','row-deleted'): model.connect(signal,changed)
    idle_mode.connect('changed',changed);idle_limit.connect('value-changed',changed)
    compact.connect('toggled',changed);font.connect('font-set',changed);length.connect('value-changed',changed)
    apply.connect('clicked',apply_display);outer.pack_start(apply,False,False,0);outer.pack_start(feedback,False,False,0)
    def close_requested(*_):
        if not dirty[0]: return False
        dialog=Gtk.MessageDialog(transient_for=win,modal=True,message_type=Gtk.MessageType.QUESTION,buttons=Gtk.ButtonsType.NONE,text='Discard unsaved preferences?')
        dialog.add_button('Keep editing',Gtk.ResponseType.CANCEL);dialog.add_button('Discard',Gtk.ResponseType.REJECT)
        result=dialog.run();dialog.destroy();return result!=Gtk.ResponseType.REJECT
    win.connect('delete-event',close_requested)
    tabs.append_page(stats,Gtk.Label(label='Statistics'))
    win.show_all();refresh()
    if active_id is not None: tabs.set_current_page(1)

def window():
    import gi
    gi.require_version('Gtk','3.0')
    from gi.repository import Gtk
    app=Gtk.Application(application_id='local.user.ActivityTracker')
    def activate(app):
        if app.get_active_window(): app.get_active_window().present()
        else: build_window(app)
    app.connect('activate',activate);app.run([])

if __name__=='__main__':
    if '--daemon' in sys.argv: daemon()
    elif '--window' in sys.argv: window()
    elif '--report' in sys.argv: print(json.dumps(rows(30),ensure_ascii=False,indent=2))
    else: panel()
