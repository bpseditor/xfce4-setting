    "/Gtk/FontName": "Inter 10",
    "/Gtk/MonospaceFontName": "JetBrains Mono 10",
    "/Xft/Antialias": 1,
    "/Xft/Hinting": 1,
    "/Xft/HintStyle": "hintslight",
    "/Xft/RGBA": "none"
  },
  "xfwm4": {
