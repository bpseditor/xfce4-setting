{
  "interval": 5,
  "show_cpu": true,
  "show_memory": true,
  "show_temperature": true,
  "show_network": false,
  "accent": "#bfbdb6",
  "panel_interval": 5,
  "warning_temperature": 80,
  "warning_memory": 90,
  "warning_battery": 20,
  "warning_color": "#df8585",
  "compact": false,
  "metric_order": "power,cpu,memory,temperature,network,runtime,swap,disk"
}
